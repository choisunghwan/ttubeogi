{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttubeogi",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",

  // 정적 프론트(React 빌드 결과물) — vite build가 dist/client 에 만들어냄.
  // /api/* 로 안 걸리는 요청은 워커보다 먼저 여기서 자동으로 매칭됨.
  // not_found_handling: 공유 링크(/p/:id) 같은 클라이언트 라우트를 새 탭에서 바로 열어도
  // 정적 자산에 없다고 404 내지 않고 index.html로 넘겨서 React Router가 처리하게 함.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // D1 — `wrangler d1 create ttubeogi-db`로 발급받은 실제(프로덕션) 데이터베이스 id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttubeogi-db",
      "database_id": "4089a4a8-8f49-4b58-92ba-0fa93140c020"
    }
  ],

  // R2 — 항목별 첨부파일(항공권/기차표/바우처 사진·PDF) 저장용.
  // `wrangler r2 bucket create ttubeogi-attachments`로 만든 버킷.
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "ttubeogi-attachments" }
  ],

  // 실시간 동기화용 Durable Object — 일정(Plan) id 하나당 PlanRoom 인스턴스 하나.
  "durable_objects": {
    "bindings": [
      { "name": "PLAN_ROOM", "class_name": "PlanRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlanRoom"] }
  ]
}
